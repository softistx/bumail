# Copy to `.env` in this folder: `cp .env.example .env`. Docker Compose reads
# it for every command run from here, so the commands stay short.

# The server's own name: its MX host, the name its certificate holds, and the
# host the Traefik routers match. The same one you give `bumail init --hostname`.
BUMAIL_HOST=mail.example.com

# Which compose file to use, so no command needs `-f`. Pick one:
#   compose.yaml              standalone: bumail owns 80, 443 and the mail ports
#   compose.traefik.yaml      behind Traefik's HTTP routers; mail ports published directly
#   compose.traefik-tcp.yaml  the same, with the mail ports behind Traefik's TCP routers
COMPOSE_FILE=compose.yaml

# The image. Built from the repository's Dockerfile by default, so nothing is
# pulled. Later, set it to the published one and run `docker compose pull`:
# BUMAIL_IMAGE=ghcr.io/softistx/bumail:<version>
BUMAIL_IMAGE=bumail:local

# The Traefik variants only -------------------------------------------------
# The external Docker network Traefik is on; bumail joins it.
TRAEFIK_NETWORK=proxy
# The name of Traefik's own certificate resolver, for the HTTPS router of JMAP.
TRAEFIK_CERT_RESOLVER=letsencrypt
