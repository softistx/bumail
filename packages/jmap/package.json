{
	"name": "@bumail/jmap",
	"version": "0.2.0",
	"description": "A JMAP server (RFC 8620, RFC 8621) on alxia: the session, the API with back-references, Mailbox, Email and Thread, blob download and upload, serving any @bumail/store",
	"license": "MIT",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"docs",
		"openapi",
		"README.md",
		"package.json",
		"LICENSE"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./openapi.json": "./openapi/jmap.json",
		"./package.json": "./package.json"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/softistx/bumail.git",
		"directory": "packages/jmap"
	},
	"publishConfig": {
		"registry": "https://registry.npmjs.org",
		"access": "public"
	},
	"scripts": {
		"build": "bun run ../../build.ts",
		"test": "bun test src",
		"typecheck": "tsc --noEmit"
	},
	"bumail": {
		"entrypoints": [
			"src/index.ts"
		]
	},
	"devDependencies": {
		"@alxia/core": "^0.3.0",
		"@alxia/openapi-routes": "^0.2.0",
		"@bumail/mime": "workspace:^",
		"@bumail/store": "workspace:^",
		"@types/bun": "^1.4.2",
		"jmap-jam": "^0.13.8"
	},
	"peerDependencies": {
		"@alxia/core": "^0.3.0",
		"@bumail/mime": "workspace:^",
		"@bumail/store": "workspace:^",
		"typescript": "^6.0.3 || ^7.0.0"
	},
	"peerDependenciesMeta": {
		"typescript": {
			"optional": true
		}
	}
}
