{
	"name": "@bumail/server",
	"version": "0.1.0",
	"description": "The bumail mail server: the @bumail/* packages wired into one process, configured by one TOML file, run as the bumail command",
	"license": "MIT",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"bin": {
		"bumail": "./dist/main.js"
	},
	"files": [
		"dist",
		"docs",
		"README.md",
		"package.json",
		"LICENSE"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/softistx/bumail.git",
		"directory": "packages/server"
	},
	"engines": {
		"bun": ">=1.4.2"
	},
	"publishConfig": {
		"registry": "https://registry.npmjs.org",
		"access": "public"
	},
	"scripts": {
		"build": "bun run ../../build.ts",
		"test": "bun test src",
		"typecheck": "tsc --noEmit"
	},
	"bumail": {
		"entrypoints": [
			"src/index.ts",
			"src/main.ts"
		]
	},
	"devDependencies": {
		"@alxia/core": "^0.3.1",
		"@bumail/acme": "workspace:^",
		"@bumail/auth": "workspace:^",
		"@bumail/dns": "workspace:^",
		"@bumail/imap": "workspace:^",
		"@bumail/jmap": "workspace:^",
		"@bumail/queue": "workspace:^",
		"@bumail/smtp": "workspace:^",
		"@bumail/store": "workspace:^",
		"@types/bun": "^1.4.2"
	},
	"peerDependencies": {
		"@alxia/core": "^0.3.1",
		"@bumail/acme": "workspace:^",
		"@bumail/auth": "workspace:^",
		"@bumail/dns": "workspace:^",
		"@bumail/imap": "workspace:^",
		"@bumail/jmap": "workspace:^",
		"@bumail/queue": "workspace:^",
		"@bumail/smtp": "workspace:^",
		"@bumail/store": "workspace:^",
		"typescript": "^6.0.3 || ^7.0.0"
	},
	"peerDependenciesMeta": {
		"typescript": {
			"optional": true
		}
	}
}
