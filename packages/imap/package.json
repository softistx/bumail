{
	"name": "@bumail/imap",
	"version": "0.1.0",
	"description": "An IMAP4rev2 server on Bun.listen (RFC 9051): STARTTLS, LOGIN and AUTHENTICATE PLAIN only once encrypted, IDLE, MOVE, SPECIAL-USE, serving any @bumail/store",
	"license": "MIT",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"docs",
		"README.md",
		"package.json",
		"LICENSE"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/softistx/bumail.git",
		"directory": "packages/imap"
	},
	"publishConfig": {
		"registry": "https://registry.npmjs.org",
		"access": "public"
	},
	"scripts": {
		"build": "bun run ../../build.ts",
		"test": "bun test src",
		"typecheck": "tsc --noEmit"
	},
	"bumail": {
		"entrypoints": [
			"src/index.ts"
		]
	},
	"devDependencies": {
		"@bumail/mime": "workspace:^",
		"@bumail/store": "workspace:^",
		"@types/bun": "^1.4.2"
	},
	"peerDependencies": {
		"@bumail/mime": "workspace:^",
		"@bumail/store": "workspace:^",
		"typescript": "^6.0.3 || ^7.0.0"
	},
	"peerDependenciesMeta": {
		"typescript": {
			"optional": true
		}
	}
}
