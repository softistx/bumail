{
	"name": "@bumail/smtp",
	"version": "0.1.0",
	"description": "An SMTP server on Bun.listen — RFC 5321 with PIPELINING, SIZE, 8BITMIME, SMTPUTF8, STARTTLS and AUTH after TLS, policy hooks, and no open relay — and a client that delivers a message to a smarthost or by MX",
	"license": "MIT",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"docs",
		"README.md",
		"package.json",
		"LICENSE"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./client": {
			"types": "./dist/client/index.d.ts",
			"import": "./dist/client/index.js",
			"default": "./dist/client/index.js"
		},
		"./package.json": "./package.json"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/softistx/bumail.git",
		"directory": "packages/smtp"
	},
	"publishConfig": {
		"registry": "https://registry.npmjs.org",
		"access": "public"
	},
	"scripts": {
		"build": "bun run ../../build.ts",
		"test": "bun test src",
		"typecheck": "tsc --noEmit"
	},
	"bumail": {
		"entrypoints": [
			"src/index.ts",
			"src/client/index.ts"
		]
	},
	"devDependencies": {
		"@bumail/auth": "workspace:^",
		"@bumail/dns": "workspace:^",
		"@bumail/store": "workspace:^",
		"@types/bun": "^1.4.2"
	},
	"peerDependencies": {
		"@bumail/dns": "workspace:^",
		"typescript": "^6.0.3 || ^7.0.0"
	},
	"peerDependenciesMeta": {
		"@bumail/dns": {
			"optional": true
		},
		"typescript": {
			"optional": true
		}
	}
}
